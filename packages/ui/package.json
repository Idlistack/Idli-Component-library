{
  "name": "@idlistack/ui",
  "version": "0.1.0",
  "description": "Idli UI — React + Tailwind components for Idlistack.",
  "license": "MIT",
  "author": "Tech4Good Community",
  "homepage": "https://github.com/Idlistack/Idli-Component-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Idlistack/Idli-Component-library.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Idlistack/Idli-Component-library/issues"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "design-system",
    "components",
    "radix",
    "idlistack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "theme.css",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "node --experimental-strip-types ../../apps/docs/scripts/gen-agent-docs.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "5.9.3"
  }
}
